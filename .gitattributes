finances_simulator/examples/generated/**/*.json text eol=lf
finances_simulator/examples/generated/**/*.jsonl text eol=lf

# Frozen training artifacts are hashed byte for byte by their own reports, so a checkout that
# rewrites their line endings breaks the promotion tests. Pin them the same way the reference runs
# above are pinned.
estimator/training/artifacts/*.json text eol=lf

# A deployment bundle is identified by the SHA-256 of its manifest, which pins every other file by
# digest. A checkout that rewrote line endings would change every one of those digests and make the
# committed bundle fail its own integrity check.
estimator/bundles/**/*.json text eol=lf

# Recorded output fixtures are compared byte for byte against what the recorder writes today, and
# the recorder writes LF. Without this pin a Windows checkout gets CRLF and the comparison fails on
# line endings while every financial value in the file is correct.
estimator/tests/fixtures/*.json text eol=lf
