# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Client and generated financial data
data/
datasets/
exports/
output/
*.parquet

# The committed reference populations are the expected bytes their byte-stability tests compare
# against, and every one of those files is already pinned by SHA-256 inside the manifest committed
# beside it. Excluding them left those tests comparing a full generated tree against two JSON files,
# which can only fail. Re-included narrowly, ahead of nothing else.
!finances_simulator/examples/generated/**/*.parquet

# Common editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Common language/tool caches and build outputs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
coverage/
.coverage
dist/
build/
*.egg-info/
*.log
